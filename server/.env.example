# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# Database
# With Docker Compose (recommended for dev):
#   DATABASE_URL=postgresql://elegance:dev_password@localhost:5432/elegance_ems
# Without Docker (SQLite fallback for quick local dev):
#   Leave DATABASE_URL unset and NODE_ENV=development
DATABASE_URL=

# Authentication
JWT_SECRET=local_dev_secret_key_elegance_2024
JWT_EXPIRES_IN=7d
# Default password for seed (set this to a strong password in production):
DEFAULT_PASSWORD=admin123
DEFAULT_EMAIL=admin@elegance.com
DEFAULT_NAME=Admin

# Redis (caching, session management, rate limiter state)
# With Docker Compose: redis://redis:6379
REDIS_URL=

# Sentry (error tracking)
SENTRY_DSN=

# HTTPS (terminate TLS at reverse proxy in production; local dev via HTTP)
USE_HTTPS=false
SSL_CERT_PATH=./ssl/server.crt
SSL_KEY_PATH=./ssl/server.key

# Geolocation (attendance check-in validation)
OFFICE_LAT=
OFFICE_LNG=
GEO_MAX_RADIUS=100

# Supabase (file storage)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=/api/auth/github/callback

# Logging
LOG_LEVEL=debug
